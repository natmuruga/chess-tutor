+def offline_answer(board: chess.Board, question: str, best_san: str | None) -> dict | None:
+    q = question.lower()
+    for key, (text, ptype) in GLOSSARY.items():
+        if key in q:
+            acts = []
+            if ptype:
+                sqs = [chess.square_name(s) for s, p in board.piece_map().items() if p.symbol().lower() == ptype][:4]
